Cell[TextData[{
 "\n",
 Cell[BoxData[
  RowBox[{"ParametricPlot3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TagBox[
       FrameBox[
        SubscriptBox["f", "x"]],
       "Placeholder"], ",", 
      TagBox[
       FrameBox[
        SubscriptBox["f", "y"]],
       "Placeholder"], ",", 
      TagBox[
       FrameBox[
        SubscriptBox["f", "z"]],
       "Placeholder"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      TagBox[
       FrameBox["u"],
       "Placeholder"], ",", 
      TagBox[
       FrameBox[
        SubscriptBox["u", "min"]],
       "Placeholder"], ",", 
      TagBox[
       FrameBox[
        SubscriptBox["u", "max"]],
       "Placeholder"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      TagBox[
       FrameBox["v"],
       "Placeholder"], ",", 
      TagBox[
       FrameBox[
        SubscriptBox["v", "min"]],
       "Placeholder"], ",", 
      TagBox[
       FrameBox[
        SubscriptBox["v", "max"]],
       "Placeholder"]}], "}"}]}], "]"}]], "Input",
  CellTags->"ParametricPlot3D_templates",ExpressionUUID->
  "99b11dd2-10aa-4d1f-a231-92ab1d179126"],
 "\nIzveido tr\:012bsdimensiju telpas l\:012bkni, kas raksturota ar \
main\:012bgo u, kas main\[ABar]s no ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "min"], TraditionalForm]],ExpressionUUID->
  "baec45f9-ffcc-4ea9-9753-f32f583f6c47"],
 " l\:012bdz ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "max"], TraditionalForm]],ExpressionUUID->
  "930d9db5-fe57-4287-a88e-61446c84bda4"],
 " , un v, kas main\[ABar]s no",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["v", "min"]}], TraditionalForm]],ExpressionUUID->
  "6ae4e207-5d5b-4cb1-9ae4-7cb2cdd1f408"],
